---
/**
 * Animated terminal for the hero. Pure DOM: the markup holds the final text so
 * the content is readable without JS, and the script only replays the reveal.
 * Respects prefers-reduced-motion by checking before it animates anything.
 */
const lines = [
  { cmd: 'postiee post "shipped a new feature today"', out: 'Posted · urn:li:ugcPost:…', tone: 'ok' },
  { cmd: 'postiee search harness', out: '1 match · “we rebuilt the harness last week”', tone: 'out' },
  { cmd: 'postiee history', out: '42 posts · newest first', tone: 'out' },
];
---

<div class="term" role="img" aria-label="A terminal showing three postiee commands: posting, searching, and listing history.">
  <div class="term__bar">
    <span class="term__dot" style="background:#ff5f57"></span>
    <span class="term__dot" style="background:#febc2e"></span>
    <span class="term__dot" style="background:#28c840"></span>
    <span class="term__title">postiee</span>
  </div>

  <div class="term__body">
    {
      lines.map((line) => (
        <div class="term__line">
          <span class="term__prompt" aria-hidden="true">$</span>{' '}
          <span class="term__cmd" data-cmd={line.cmd}></span>
        </div>
        <div class={`term__out term__out--${line.tone}`} data-out>
          {line.out}
        </div>
      ))
    }
    <div class="term__line">
      <span class="term__prompt" aria-hidden="true">$</span>{' '}
      <span class="term__caret" aria-hidden="true"></span>
    </div>
  </div>
</div>

<style>
  .term {
    margin: 0;
    height: 100%;
    border: 0;
    border-radius: 0;
    box-shadow: none;
    text-align: left;
    background: #0d0d10;
    border: 1px solid var(--hairline-2);
    border-radius: var(--r-md);
    overflow: hidden;
    box-shadow:
      0 1px 0 rgba(255, 255, 255, .04) inset,
      0 24px 60px -30px rgba(0, 0, 0, .9);
  }

  .term__bar {
    display: flex; align-items: center; gap: .45rem;
    padding: .7rem .9rem;
    border-bottom: 1px solid var(--hairline-2);
    background: rgba(255, 255, 255, .03);
  }
  .term__dot { width: .7rem; height: .7rem; border-radius: 50%; display: block; }
  .term__title {
    margin-left: .5rem;
    font-family: var(--mono); font-size: .75rem; color: var(--fg-3);
  }

  .term__body {
    padding: 1.1rem 1.25rem 1.35rem;
    font-family: var(--mono); font-size: .82rem; line-height: 1.75;
  }

  .term__prompt { color: var(--accent); user-select: none; }
  .term__cmd { color: var(--fg); }

  .term__out {
    color: var(--fg-3);
    padding-left: 1.15rem;
    margin-bottom: .55rem;
  }
  .term__out--ok { color: var(--accent); }

  .term__caret {
    display: inline-block; width: .5rem; height: 1em;
    background: var(--accent); vertical-align: text-bottom;
    animation: blink 1.1s steps(2, start) infinite;
  }
  @keyframes blink { to { visibility: hidden; } }

  /* Entrance: each pair fades up in sequence. Set up in markup-free CSS so a
     script failure still leaves readable, settled text. */
  .term__line, .term__out {
    opacity: 0;
    animation: rise .5s cubic-bezier(.2, .7, .3, 1) forwards;
  }
  .term__line:nth-of-type(1) { animation-delay: .35s; }
  .term__out:nth-of-type(2)   { animation-delay: .85s; }
  .term__line:nth-of-type(3) { animation-delay: 1.35s; }
  .term__out:nth-of-type(4)   { animation-delay: 1.9s; }
  .term__line:nth-of-type(5) { animation-delay: 2.4s; }
  .term__line:nth-of-type(6) { animation-delay: 3.1s; }

  @keyframes rise {
    from { opacity: 0; transform: translateY(6px); }
    to   { opacity: 1; transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .term__line, .term__out { opacity: 1; animation: none; }
    .term__caret { animation: none; }
  }
</style>

<script>
  // Type the command text into each line. With reduced motion the <span> stays
  // empty, so fill it immediately instead of leaving the line blank.
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const spans = document.querySelectorAll<HTMLElement>('.term__cmd');

  if (reduced || !spans.length) {
    spans.forEach((s) => (s.textContent = s.dataset.cmd ?? ''));
  } else {
    const type = (el: HTMLElement, i: number) => {
      const text = el.dataset.cmd ?? '';
      let n = 0;
      const tick = () => {
        if (n > text.length) return;
        el.textContent = text.slice(0, n++);
        setTimeout(tick, 22 + Math.random() * 30);
      };
      setTimeout(tick, i * 1000 + 400);
    };
    spans.forEach((s, i) => type(s, i));
  }
</script>
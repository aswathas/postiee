---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Renders the sidebar toggle; only meaningful for pages that have one. */
  docsMenu?: boolean;
}

const { title, description, docsMenu = false } = Astro.props;

// Pages are served from a subpath, so internal links need the base prepended.
// BASE_URL carries no trailing slash.
const rawBase = import.meta.env.BASE_URL;
const base = `${rawBase.replace(/\/$/, '')}/`;
const u = (p: string) => `${base}${p.replace(/^\//, '')}`;

const path =
  Astro.url.pathname.replace(/\/$/, '').replace(new RegExp(`^${rawBase}`), '') || '/';
const isActive = (href: string) =>
  path === href || (href !== '/' && path.startsWith(href));

const nav = [
  { href: '/docs', label: 'Docs' },
  { href: '/docs/commands', label: 'Commands' },
  { href: '/docs/limits', label: 'Limits' },
  { href: '/docs/how-it-works', label: 'How it works' },
  { href: '/about', label: 'About' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · postiee</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={`${title} · postiee`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <nav class="nav" aria-label="Main">
      <div class="nav__in">
        <a class="brand" href={u('/')}>
          <svg width="19" height="19" viewBox="0 0 24 24" aria-hidden="true" fill="none">
            <rect x="2" y="5" width="20" height="14" rx="3" stroke="currentColor" stroke-width="1.7"></rect>
            <path d="M6.5 10.5v3M10 10.5v3M13.5 10h4M13.5 14h4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path>
          </svg>
          postiee
        </a>

        {
          docsMenu && (
            <button class="nav__toggle nav__toggle--docs" id="docsMenu" aria-expanded="false" aria-controls="sidebar">
              <span class="sr-only">Toggle documentation menu</span>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M4 6h16M4 12h16M4 18h10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
              </svg>
            </button>
          )
        }

        <button class="nav__toggle" id="navToggle" aria-expanded="false" aria-controls="navLinks">
          <span class="sr-only">Toggle navigation</span>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
          </svg>
        </button>

        <div class="nav__links" id="navLinks">
          {
            nav.map((item) => (
              <a
                class="nav__link"
                href={u(item.href)}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))
          }
          <a
            class="nav__link"
            href="https://github.com/aswathas/postiee"
            rel="noopener">GitHub</a
          >
        </div>
      </div>
    </nav>

    <main id="main">
      <slot />
    </main>

    <footer class="footer">
      <p>
        <a href="https://github.com/aswathas/postiee">Source</a> ·
        Built by <a href="https://github.com/aswathas">Aswath AS</a> ·
        Apache-2.0
      </p>
    </footer>

    <script>
      document.documentElement.classList.add('js');

      const toggle = document.getElementById('navToggle');
      const links = document.getElementById('navLinks');
      toggle?.addEventListener('click', () => {
        const open = links?.dataset.open !== 'true';
        if (links) links.dataset.open = String(open);
        toggle.setAttribute('aria-expanded', String(open));
      });

      // Copy buttons. Progressive enhancement: without JS the code is still
      // selectable and every page still works.
      document.addEventListener('click', async (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.copy');
        if (!btn) return;
        const code = btn.closest('.codeblock')?.querySelector('code')?.textContent ?? '';
        const label = btn.querySelector('.copy__text');
        try {
          await navigator.clipboard.writeText(code);
          btn.dataset.state = 'done';
          if (label) label.textContent = 'Copied';
        } catch {
          if (label) label.textContent = 'Ctrl+C';
        }
        setTimeout(() => {
          btn.dataset.state = '';
          if (label) label.textContent = 'Copy';
        }, 2000);
      });

      // Scroll reveal. Only hides elements it is also able to reveal.
      const targets = document.querySelectorAll('.reveal');
      if (targets.length) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('in');
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -12% 0px' }
        );
        targets.forEach((t) => io.observe(t));
      }
    </script>
  </body>
</html>